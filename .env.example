# Copy to .env.local. Never commit .env.local.

# Players needed to fill a match, and how long its price clock runs (seconds).
NEXT_PUBLIC_MATCH_SIZE=3
NEXT_PUBLIC_MATCH_SECONDS=300

# Contract addresses, set after `npm run deploy:registry` and `npm run deploy:escrow`.
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_ESCROW_ADDRESS=

# Lobby timing in seconds. These MUST equal the values the registry was deployed with.
NEXT_PUBLIC_LOBBY_SECONDS=120
NEXT_PUBLIC_CONFIRM_SECONDS=60

# Default leverage offered to a player (they can pick their own, up to the market's limit).
NEXT_PUBLIC_LEVERAGE=5

# Server-side only, used by the deploy and operator scripts. Never use NEXT_PUBLIC_ for these.
# DEPLOYER_KEY=
# OPERATOR_KEY=
